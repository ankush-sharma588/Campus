# Copy to .env (local) or add these in your host's dashboard (Render / Vercel)
PORT=4518

# MongoDB Atlas connection string
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/placehub

# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Cloudinary (profile photos, resumes, offer letters)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail address + App Password used to send emails
SMTP_USER=
SMTP_PASS=
SMTP_SERVICE=gmail
MAIL_FROM_NAME=PlaceHub

# Public frontend URL used in notification email buttons
FRONTEND_URL=https://dcrust-campus-placement.vercel.app

# Optional SMTP host settings (leave blank when using SMTP_SERVICE=gmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Deployed frontend URL(s) allowed by CORS, comma separated. Leave empty in local dev.
CLIENT_URL=http://localhost:5173

# Use a long random secret for OTP hashing (can fall back to JWT_SECRET)
OTP_SECRET=
