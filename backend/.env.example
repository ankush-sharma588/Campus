# Copy to .env for local development, or set these in the Render dashboard.
NODE_ENV=development
PORT=4518

# MongoDB Atlas connection string (or a local MongoDB URL).
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/placehub

# Authentication secrets: use separate long, random values.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h
OTP_SECRET=replace-with-a-different-long-random-secret

# One-time initial password for the permanent management/superadmin accounts.
# Set this in Render; do not commit the actual value.
BOOTSTRAP_ADMIN_PASSWORD=

# Cloudinary (profile photos, resumes, offer letters).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo transactional email API.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PlaceHub

# Public URL used in links in notification emails.
FRONTEND_URL=http://localhost:5173

# Comma-separated allowed frontend origins (origins only, without paths).
CLIENT_URL=http://localhost:5173
