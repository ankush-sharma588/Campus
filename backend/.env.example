# Copy to .env for local development, or configure these in Render's dashboard.
PORT=4518

# MongoDB Atlas connection string
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/placehub

# Long random strings used by authentication and OTP hashing
JWT_SECRET=change-me-to-a-long-random-string
OTP_SECRET=use-a-different-long-random-string

# Cloudinary (profile photos, resumes, offer letters)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo transactional email API (HTTPS; works with Render Free)
# Create an API key in Brevo and verify the sender email address in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PlaceHub

# Public frontend URL used in notification email buttons
FRONTEND_URL=https://dcrust-campus-placement.vercel.app

# Deployed frontend URL(s) allowed by CORS, comma separated.
CLIENT_URL=http://localhost:5173
